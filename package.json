{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portafolio personal desarrollado con tecnologías web modernas para presentar proyectos, arquitectura front-end y experiencia en desarrollo de software.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jandresrc105-svg/portfolio-web.git"
  },
  "author": "Juan Reyes <jandresrc105@gmail.com>",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  }
}
